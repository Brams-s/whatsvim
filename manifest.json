{
  "manifest_version": 3,
  "name": "WhatsVim",
  "version": "0.4.0",
  "version_name": "0.4.0",
  "description": "Vim-style Normal and Insert modes for WhatsApp Web.",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/whatsvim-16.png",
    "32": "icons/whatsvim-32.png",
    "48": "icons/whatsvim-48.png",
    "128": "icons/whatsvim-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "keymap.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
